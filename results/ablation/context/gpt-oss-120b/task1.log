    import math
    
    def lateralsuface_cylinder(r, h):
        """
        Calculate the lateral surface area of a cylinder.
    
        Parameters
        ----------
        r : float or int
            Radius of the cylinder's base.
        h : float or int
            Height of the cylinder.
    
        Returns
        -------
        float
            Lateral surface area = 2 * π * r * h
        """
        return 2 * math.pi * r * h
    
    final_answer(lateralsuface_cylinder)
