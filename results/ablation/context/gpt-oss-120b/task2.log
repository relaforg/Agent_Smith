    def check_Consecutive(l):
        """
        Check whether the given list contains consecutive numbers.
    
        The function returns True if the elements of the list can be rearranged
        to form a sequence of consecutive integers without any gaps or duplicates.
        Otherwise it returns False.
    
        Parameters
        ----------
        l : list[int]
            List of integers to be examined.
    
        Returns
        -------
        bool
            True if the list contains consecutive numbers, False otherwise.
        """
        # Need at least two distinct numbers to form a consecutive sequence
        if len(l) < 2:
            return False
    
        # Duplicates break consecutiveness
        if len(set(l)) != len(l):
            return False
    
        # For a set of consecutive numbers, max - min must equal length - 1
        return max(l) - min(l) == len(l) - 1
