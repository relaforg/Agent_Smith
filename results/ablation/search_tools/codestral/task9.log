    print(run_command(["python", "-c", """
    from django.db.models.sql.compiler import SQLCompiler
    from django.db.models.query import QuerySet
    
    class ReservedName:
        def __init__(self, name, order):
            self.name = name
            self.order = order
    
    class MockCompiler(SQLCompiler):
        def __init__(self, query):
            self.query = query
    
    class MockQuery:
        def __init__(self):
            self.values_select = ['name', 'order']
            self.extra_select = []
            self.annotation_select = []
    
        def set_values(self, values):
            self.values_select = list(values)
    
    query = MockQuery()
    compiler = MockCompiler(query)
    compiler.query.values_select = ['order']
    print(compiler.query.values_select)
    """], "/testbed"))
